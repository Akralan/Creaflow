# Base de dev lancée par `npm run setup` / `docker compose up -d` (docker-compose.yml).
# Pointer ailleurs si l'on utilise un Postgres déjà installé — il lui faut l'extension pgvector.
DATABASE_URL=postgres://creaflow:creaflow@localhost:5433/creaflow_poc
APP_URL=http://localhost:3000

# Provider LLM utilisé pour la génération de contenu : "gemini" (quota gratuit Google AI Studio), "anthropic", "groq" (quota gratuit généreux) ou "openai"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY est également requis par l'ASSISTANT ÉDITORIAL, quel que soit LLM_PROVIDER : sa boucle
# agentique (outils multi-tours) n'est implémentée que chez OpenAI — cf. docs/SPEC_ASSISTANT_AGENTIQUE.md §2.2.
# Sans cette clé, toute l'app fonctionne sauf l'écran /assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# OAuth (à remplir une fois les apps développeur approuvées par chaque plateforme)
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# X (Twitter) — pay-per-use depuis février 2026 ($0,005/lecture de post), nécessite un compte de
# facturation ouvert avant toute activation réelle (docs/SPEC_METRIQUES_AUTO.md §2.5).
X_CLIENT_ID=
X_CLIENT_SECRET=
# Signature des sessions — obligatoire, toute connexion échoue sans. `npm run setup` en génère un.
AUTH_SECRET=

# Stockage objet pour la bibliothèque de ressources visuelles (Cloudflare R2, S3-compatible)
# docs/SPEC_RESSOURCES_VISUELLES.md — vignettes + images générées, jamais les photos sources.
STORAGE_PROVIDER=r2
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Google Picker / Google Drive (ingestion de la bibliothèque de ressources visuelles, scope drive.file)
# Ces mêmes identifiants sont réutilisés par le provider YouTube (src/lib/social/youtube.ts,
# scopes youtube.readonly + yt-analytics.readonly) — il faut en plus enregistrer la redirect URI
# `${APP_URL}/api/auth/youtube/callback` dans le même projet Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=

# Génération d'images (Nano Banana) et captioning vision — utilisent GEMINI_API_KEY même si
# LLM_PROVIDER n'est pas "gemini". Les EMBEDDINGS, eux, sont passés à OpenAI (OPENAI_EMBEDDING_MODEL,
# ci-dessous) : le modèle Gemini text-embedding-004 a été retiré côté Google.
GEMINI_IMAGE_MODEL=gemini-3-pro-image
# Embeddings de la bibliothèque visuelle — OpenAI, indépendamment de LLM_PROVIDER, en 768 dimensions
# pour tenir dans brandAssets.embedding (vector(768)). Changer ce modèle impose de recalculer les
# embeddings existants : POST /api/assets/reembed (deux modèles ne sont pas comparables entre eux).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Facturation Stripe (self-service, mode "subscription"). STRIPE_PRICE_* sont des IDs de Price
# créés côté Stripe Dashboard/CLI (docs/TECH.md) — jamais un montant en dur dans le code
# (src/lib/billing/plans.ts). STRIPE_WEBHOOK_SECRET vient de la souscription au webhook
# (endpoint /api/billing/webhook) dans le Dashboard Stripe ou de `stripe listen` en local.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Monitoring d'erreurs (Sentry). Optionnel : sans DSN, Sentry.init() tourne avec dsn:undefined et
# ne fait rien (silencieux, cf. src/instrumentation.ts) — l'app fonctionne normalement sans.
# SENTRY_DSN (serveur) et NEXT_PUBLIC_SENTRY_DSN (client, exposé au navigateur — un DSN Sentry
# n'est pas un secret) pointent en général vers le même projet Sentry.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Onboarding développeur (OAuth App GitHub, scope "read:user user:email"). Créer l'app sur
# github.com > Settings > Developer settings > OAuth Apps, avec l'URL de callback ci-dessous.
# Optionnel : sans ces variables, le bouton "Continuer avec GitHub" n'est pas affiché sur /login et
# le parcours email/mot de passe reste entièrement fonctionnel — même philosophie que Stripe.
# Aucun scope "repo"/"public_repo" n'est demandé : seuls les dépôts publics sont lus, et
# "public_repo" accorderait en plus l'écriture, dont l'app n'a aucun usage.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/github/callback
