DATABASE_URL=postgres://user:password@localhost:5432/creaflow_poc
APP_URL=http://localhost:3000

# Provider LLM utilisé pour la génération de contenu : "gemini" (quota gratuit Google AI Studio) ou "anthropic"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# OAuth (à remplir une fois les apps développeur approuvées par chaque plateforme)
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
AUTH_SECRET=
