# Dev database started by `npm run setup` / `docker compose up -d` (docker-compose.yml).
# Point elsewhere to use an already installed Postgres — it needs the pgvector extension.
DATABASE_URL=postgres://creaflow:creaflow@localhost:5433/creaflow_poc
APP_URL=http://localhost:3000
# Indexing by search engines (src/lib/seo.ts): empty = derived from APP_URL (never locally). Set "true"
# to test robots.txt / sitemap.xml as they will be in production.
SEO_INDEXABLE=

# LLM provider used for content generation. ONLY "openai" IS OPERATIONAL today:
# "gemini", "anthropic" and "groq" exist in the code but do not run the app (see README).
LLM_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY is also required by the EDITORIAL ASSISTANT, whatever LLM_PROVIDER is: its agentic
# loop (multi-turn tools) is only implemented for OpenAI — see docs/SPEC_ASSISTANT_AGENTIQUE.md §2.2.
# Without this key, the whole app works except the /assistant screen.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# OAuth (fill in once the developer apps are approved by each platform)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# X (Twitter) — pay-per-use since February 2026 ($0.005/post read), requires a billing
# account to be opened before any real activation (docs/SPEC_METRIQUES_AUTO.md §2.5).
X_CLIENT_ID=
X_CLIENT_SECRET=
# Session signing — mandatory, every sign-in fails without it. `npm run setup` generates one.
AUTH_SECRET=

# Object storage for the visual resource library (Cloudflare R2, S3-compatible)
# docs/SPEC_RESSOURCES_VISUELLES.md — thumbnails + generated images, never the source photos.
STORAGE_PROVIDER=r2
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Google Picker / Google Drive (ingestion of the visual resource library, drive.file scope)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=

# Vision captioning of library photos — uses GEMINI_API_KEY even if LLM_PROVIDER
# is not "gemini". The EMBEDDINGS, for their part, go through OpenAI (OPENAI_EMBEDDING_MODEL, below):
# the Gemini text-embedding-004 model was retired by Google.

# Photo background removal (docs/SPEC_COMPOSITION_VISUELLE.md) — optional. Without these variables, the
# feature is simply absent (no "cutout" toggle, the agent does not offer it).
# Photoroom: ~$0.02 per photo, only once per photo (cached). A key prefixed
# `sandbox_` is free with a watermark (100 calls/day) for development.
BACKGROUND_REMOVAL_PROVIDER=photoroom
PHOTOROOM_API_KEY=
# Visual library embeddings — OpenAI, independently of LLM_PROVIDER, in 768 dimensions
# to fit in brandAssets.embedding (vector(768)). Changing this model requires recomputing the existing
# embeddings: POST /api/assets/reembed (two models are not comparable with each other).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Admin accounts (docs/SPEC_QUOTAS_ADMIN.md): comma-separated emails. An admin uses
# the application like everyone else, and additionally has access to /admin/quotas (custom quotas).
# Empty = nobody. Read at server startup: restart after a change.
ADMIN_EMAILS=

# Stripe billing (self-service, "subscription" mode). STRIPE_PRICE_* are Price IDs
# created on the Stripe side via Dashboard/CLI (docs/TECH.md) — never an amount hard-coded in the code
# (src/lib/billing/plans.ts). STRIPE_WEBHOOK_SECRET comes from the webhook subscription
# (endpoint /api/billing/webhook) in the Stripe Dashboard or from `stripe listen` locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Service emails (password reset, security notices, deletion confirmation —
# docs/SPEC_LEGAL_EMAIL_RGPD.md §3). Same philosophy as Stripe: without BREVO_API_KEY, the app starts in
# "console" mode and writes each email to the logs (the reset link can be read there directly).
# EMAIL_PROVIDER=brevo without a key is refused when sending starts, so as not to believe an email is going out.
# EMAIL_FROM: "Name <address>" on a domain verified at Brevo (Settings > Senders & Domains).
EMAIL_PROVIDER=console
BREVO_API_KEY=
EMAIL_FROM=Tellovo <no-reply@localhost>

# Error monitoring (Sentry). Optional: without a DSN, Sentry.init() runs with dsn:undefined and
# does nothing (silent, see src/instrumentation.ts) — the app works normally without it.
# SENTRY_DSN (server) and NEXT_PUBLIC_SENTRY_DSN (client, exposed to the browser — a Sentry DSN
# is not a secret) generally point to the same Sentry project.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Developer onboarding (GitHub OAuth App, scope "read:user user:email"). Create the app at
# github.com > Settings > Developer settings > OAuth Apps, with the callback URL below.
# Optional: without these variables, the "Continue with GitHub" button is not shown on /login and
# the email/password path stays fully functional — same philosophy as Stripe.
# No "repo"/"public_repo" scope is requested: only public repositories are read, and
# "public_repo" would additionally grant write access, which the app has no use for.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# /start flow (docs/SPEC_ENTREE_PAR_LE_REPO.md): public repositories are read WITHOUT any GitHub account,
# by the server. A token with NO scope (github.com > Settings > Developer settings > Personal access
# tokens) lifts the limit from 60 to 5000 requests per hour; that quota is counted on the server's IP, shared
# by every visitor, and one repository costs about 10 to 55 requests. Strongly recommended beyond a few tries.
GITHUB_TOKEN=
# New accounts allowed per day through /start (global cap on the generation cost). Default 50.
START_DAILY_CAP=50

# Daily sync of every connected source (docs/SPEC_SYNCHRO_QUOTIDIENNE.md): the VPS cron calls
# POST /api/cron/sync with `Authorization: Bearer <CRON_SECRET>`. Empty: the route answers 503 and
# nothing is synced automatically (the manual path still works).
CRON_SECRET=

# Notion and Linear as entry doors (sign-up/sign-in) AND material sources
# (docs/SPEC_CONNECTEURS_ET_SUJETS.md). Same philosophy as GitHub and Stripe: without these variables,
# the "Continue with …" button does not appear on /login and the rest of the app works.
# Redirect URI to declare on both sides: ${APP_URL}/api/auth/oauth/<provider>/callback
#
# Notion — create a PUBLIC integration at https://www.notion.so/my-integrations (an internal
# integration cannot be authorised by other accounts). An integration only sees the pages
# the user explicitly shares with it.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Linear — https://linear.app/settings/api/applications, "read" scope only. The access token
# is only valid for 24 h: refreshing is mandatory, not optional.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Numbers of the posts on X (docs/SPEC_PERFORMANCE.md §4). "apify" reads the public numbers of the author's handle
# (settings > X handle) through an Apify actor — far cheaper than the X API and no X connection needed; "x_api" uses
# the paid X API. Left empty: Apify when APIFY_TOKEN is set, else the X API.
X_METRICS_PROVIDER=
APIFY_TOKEN=
# Actor that reads a handle's latest posts (default apidojo/tweet-scraper). Check its current price and fields.
APIFY_X_ACTOR=
