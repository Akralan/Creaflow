# .env de PRODUCTION — à copier à la racine du dépôt sur le VPS :  cp deploy/env.production.example .env
# Guide : docs/DEPLOIEMENT_VPS.md §4. Les variables marquées (obligatoire) suffisent à mettre la
# landing en ligne et à créer des comptes ; tout le reste active une fonctionnalité à la fois,
# exactement comme en dev (.env.example documente chacune en détail).

# ---- Serveur (obligatoire) ----------------------------------------------------------------
# Domaine sur lequel Caddy sert l'app et demande son certificat. Sans schéma, sans slash.
APP_DOMAIN=app.exemple.fr
# Même domaine, avec https:// : utilisé dans les liens d'email, les retours Stripe et OAuth.
APP_URL=https://app.exemple.fr
# Indexation par les moteurs (docs/SPEC_SEO.md §3). Vide : décidé d'après APP_URL — oui pour un vrai
# domaine en https, non pour localhost ou un hôte de démo (*.vps.ovh.ca, *.sslip.io). "true"/"false"
# pour forcer. Lue au build : changer sa valeur demande un deploy/update.sh.
SEO_INDEXABLE=
# Mot de passe du Postgres du VPS. Générer :  openssl rand -hex 24
POSTGRES_PASSWORD=
# DOIT reprendre POSTGRES_PASSWORD ci-dessus (Compose n'interpole pas dans ce fichier).
# "postgres" est le nom du service dans docker-compose.prod.yml, pas localhost.
DATABASE_URL=postgres://creaflow:REMPLACER_PAR_POSTGRES_PASSWORD@postgres:5432/creaflow
# Signature des sessions. Générer :  openssl rand -hex 32
AUTH_SECRET=

# ---- Emails de service (obligatoire : l'un OU l'autre) --------------------------------------
# En production l'app refuse de deviner : soit une clé Brevo (docs/SETUP_EMAILS_BREVO.md), soit
# EMAIL_PROVIDER=console écrit noir sur blanc (les liens de réinitialisation ne partent alors pas).
EMAIL_PROVIDER=console
BREVO_API_KEY=
EMAIL_FROM=CreaFlow <no-reply@exemple.fr>

# ---- Génération de contenu --------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- Bibliothèque visuelle (Cloudflare R2, docs/SETUP_RESSOURCES_VISUELLES.md) --------------
STORAGE_PROVIDER=r2
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
# Bucket PRIVÉ distinct pour les sauvegardes de la base (deploy/backup.sh). Jamais le bucket
# public des vignettes.
BACKUP_BUCKET=creaflow-backups
BACKGROUND_REMOVAL_PROVIDER=photoroom
PHOTOROOM_API_KEY=

# ---- Google (Picker Drive + YouTube) — inliné au build, rebuild si ça change ----------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=

# ---- Facturation Stripe (docs/TECH.md §6) ---------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# ---- Monitoring (NEXT_PUBLIC_SENTRY_DSN est inliné au build) ----------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---- Portes d'entrée et sources de matière ------------------------------------------------------
# Redirect URI à déclarer chez chaque fournisseur : ${APP_URL}/api/auth/oauth/<provider>/callback
# (GitHub garde sa route historique ci-dessous).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://app.exemple.fr/api/auth/github/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# ---- Réseaux sociaux (Module A) ---------------------------------------------------------------
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
